# Copy to .env (npm start reads it) and fill in. Never commit the real one.
# This app's own settings only: do not copy values from another project's .env (the app ignores such names and hides them from the converters).
GRID_APP_PASSWORD=change-me-at-least-8-characters

# PORT=3000
# DATA_DIR=./data
# GRID_TOOLS_DIR=..
# PYTHON=
# SESSION_SECRET=a-long-random-string        # set it to stay signed in across restarts
# COOKIE_SECURE=1                            # behind https
# TRUST_PROXY=1                              # behind a reverse proxy
# MAX_UPLOAD_MB=150
# MAX_PARALLEL_RUNS=2
# RUN_TIMEOUT_MS=1200000
# MEMORY_AUTO_APPLY=0.9
# MEMORY_SUGGEST=0.65

# Optional advisor (a language model that may SUGGEST an answer for something memory knows nothing about; never applied by itself).
# It uses the paid API. Keep the key HERE, not in the PC's environment variables (Claude Code would bill that key instead of the subscription).
# ADVISOR=1
# ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-sonnet-5-5
